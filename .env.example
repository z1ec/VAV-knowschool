# Секрет для подписи сессий Flask — сгенерировать один раз, например: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# development снимает Secure-флаг с сессионной куки для локального теста без HTTPS.
# На боевом сервере (за HTTPS reverse-proxy) не задавать вовсе.
FLASK_ENV=development

# Единственный админ создаётся автоматически при первом запуске контейнера.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP для отправки заявок с формы на почту школы (любой провайдер: Яндекс 360, Mail.ru, хостинг).
# Порт 465 — SMTP_SSL, любой другой — STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Необязательно: секретный ключ Yandex SmartCaptcha. Пока не задан — проверка капчи
# всегда проходит (для формы уже включена антибот-защита honeypot + rate-limit).
CAPTCHA_SECRET_KEY=
